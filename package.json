{
  "name": "playlist-zamani",
  "version": "1.6.6",
  "private": true,
  "type": "module",
  "description": "YouTube playlist süre asistanı ve tüm siteler için hafif video hız kontrolü.",
  "repository": {
    "type": "git",
    "url": "https://github.com/csmutlu/playlist-uzunluk.git"
  },
  "bugs": {
    "url": "https://github.com/csmutlu/playlist-uzunluk/issues"
  },
  "homepage": "https://github.com/csmutlu/playlist-uzunluk#readme",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:brave": "npm run build && node scripts/brave-smoke.mjs",
    "test:zen": "npm run zip:firefox && node scripts/zen-smoke.mjs",
    "test:firefox": "npm run zip:firefox && GECKO_NAME=Firefox GECKO_BINARY=/Applications/Firefox.app/Contents/MacOS/firefox node scripts/zen-smoke.mjs",
    "test:gecko": "npm run test:zen && npm run test:firefox",
    "test:tabii": "npm run build && node scripts/tabii-live-test.mjs",
    "test:stress": "npm run build && node scripts/universal-stress.mjs",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "check:firefox": "npm run typecheck && npm run test && npm run build:firefox",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "preact": "10.29.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.2",
    "@types/chrome": "0.1.20",
    "jsdom": "26.1.0",
    "playwright-core": "^1.54.2",
    "selenium-webdriver": "^4.37.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wxt": "0.21.2"
  }
}
